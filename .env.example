# ---------------------------------------------------------------------------
# Local environment template.
#
# Copy this file to `.env.local` and replace the placeholder values with your
# real local credentials. `.env.local` (and every other `.env*` file except
# this template) is git-ignored and must never be committed.
#
# The Next.js application loads `.env.local` automatically. Automated tests
# load `.env.test.local` first, then `.env.local`; real environment variables
# always take precedence.
# ---------------------------------------------------------------------------

# Development database (PostgreSQL). Used by the application and by Drizzle
# migrations (`npm run db:generate`, `npm run db:migrate`).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lead_tracking_platform

# Dedicated database for automated tests. Must be a separate database whose
# name ends with `_test`; tests refuse to run against any other database name
# and refuse non-local hosts unless ALLOW_REMOTE_TEST_DATABASE=true.
# Create it once with: npm run db:create-test
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lead_tracking_platform_test

# Secret used by Better Auth to sign sessions and tokens. Generate a strong,
# unique value, e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=GENERATE_A_UNIQUE_SECRET

# Base URL where the application is served (used by Better Auth).
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated Better Auth user IDs allowed to act as platform operators.
# Leave empty until a platform operator account exists.
PLATFORM_OPERATOR_USER_IDS=

# Only set this to `true` to intentionally run automated tests against a
# non-local *test* database (for example, a CI-only branch). Never point this
# at a production database.
# ALLOW_REMOTE_TEST_DATABASE=false
